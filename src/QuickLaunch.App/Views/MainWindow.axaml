<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickLaunch.App.ViewModels"
        xmlns:models="using:QuickLaunch.Core.Models"
        x:Class="QuickLaunch.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="工具管理"
        Width="720" Height="500"
        MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBg}"
        SystemDecorations="BorderOnly"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        Closing="OnClosing"
        KeyDown="OnWindowKeyDown"
        PointerMoved="OnWindowPointerMoved"
        PointerPressed="OnWindowPointerPressed"
        PointerReleased="OnWindowPointerReleased"
        PointerExited="OnWindowPointerExited"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Button.titleBtn">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button.titleBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#14000000" />
    </Style>
    <Style Selector="Button.closeBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFE81123" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="#0F000000" />
    </Style>
    <Style Selector="Button.menuItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Window.Styles>

  <LayoutTransformControl>
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
    </LayoutTransformControl.LayoutTransform>

    <Border BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" Background="{DynamicResource ContentBg}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource TitleBg}"
                BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPressed">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
              <TextBox x:Name="QueryBox" Width="200" Height="24" IsVisible="{Binding IsSearchOpen}"
                       Watermark="搜索..." Text="{Binding Query}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Classes="titleBtn" Content="🔍" Command="{Binding ToggleSearchCommand}" ToolTip.Tip="搜索 Ctrl+F" />
              <Button Classes="titleBtn" Content="☰" Click="OnMenuClick" ToolTip.Tip="菜单" />
              <Button Classes="titleBtn" Content="□" Click="OnMaximizeClick" ToolTip.Tip="最大化/还原" />
              <Button Classes="titleBtn" Content="—" Click="OnMinimizeClick" />
              <Button Classes="titleBtn closeBtn" Content="✕" Click="OnCloseClick" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- add panel -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsAddPanelOpen}" Padding="12"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="添加项目（可直接拖文件进来）" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*,Auto,*">
              <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding NewName}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewType}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="路径" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding NewPath}" Watermark="文件或程序路径" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,*">
              <TextBlock Text="参数" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding NewArgs}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="工作目录" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="3" Text="{Binding NewWorkDir}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Text="快捷键" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding NewHotkey}" Watermark="可选，如 Ctrl+Alt+1" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="确定" Command="{Binding AddItemCommand}" Margin="0,0,8,0" />
              <Button Grid.Column="3" Content="取消" Command="{Binding CloseAddPanelCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- edit panel -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsEditPanelOpen}" Padding="12"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="编辑快捷方式" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*,Auto,*">
              <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding EditName}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding EditType}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="路径" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding EditPath}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,*">
              <TextBlock Text="参数" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding EditArgs}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="工作目录" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="3" Text="{Binding EditWorkDir}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
              <TextBlock Text="快捷键" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding EditHotkey}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="2" Text="移到" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding GroupNames}" SelectedItem="{Binding MoveTargetGroupName}" Margin="0,0,8,0" />
              <Button Grid.Column="4" Content="移动" Command="{Binding MoveSelectedToGroupCommand}" Margin="0,0,8,0" />
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                <Button Content="保存" Command="{Binding SaveEditCommand}" />
                <Button Content="取消" Command="{Binding CloseEditPanelCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- rename category panel -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsRenameGroupOpen}" Padding="12"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="重命名分类" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding EditGroupName}" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="保存" Command="{Binding SaveRenameGroupCommand}" Margin="0,0,8,0" />
              <Button Grid.Column="3" Content="取消" Command="{Binding CloseRenameGroupCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- settings -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsSettingsOpen}" Padding="12"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="10">
            <TextBlock Text="设置" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*,Auto,*">
              <TextBlock Text="呼出热键" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding Config.Hotkey}" Margin="0,0,16,0" Watermark="如 Alt+Space" />
              <TextBlock Grid.Column="2" Text="界面" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding Themes}" SelectedItem="{Binding Config.Theme}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,*">
              <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0" />
              <NumericUpDown Grid.Column="1" Minimum="0.8" Maximum="1.6" Increment="0.05"
                             Value="{Binding Config.Scale}" FormatString="0.00" Margin="0,0,16,0" />
              <TextBlock Grid.Column="2" Text="侧栏宽" VerticalAlignment="Center" Margin="0,0,8,0" />
              <NumericUpDown Grid.Column="3" Minimum="140" Maximum="360" Increment="10"
                             Value="{Binding Config.SidebarWidth}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="20">
              <CheckBox Content="开机启动" IsChecked="{Binding Config.StartWithWindows}" />
              <CheckBox Content="启动程序后隐藏窗口" IsChecked="{Binding Config.HideAfterLaunch}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="保存" Command="{Binding ApplySettingsCommand}" />
              <Button Content="关闭" Command="{Binding CloseSettingsCommand}" />
              <TextBlock Text="{Binding StatusText}" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Grid>
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="{Binding SidebarWidth}" Background="{DynamicResource SidebarBg}"
                    BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,1,0"
                    DragDrop.AllowDrop="True"
                    ContextRequested="OnSidebarContextRequested"
                    MinWidth="140">
              <ListBox ItemsSource="{Binding GroupNodes}" SelectedItem="{Binding SelectedNode}"
                       Background="Transparent" BorderThickness="0"
                       HorizontalAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GroupNodeVm">
                    <Border Padding="{Binding RowPadding}" Tag="{Binding}"
                            Background="Transparent"
                            Cursor="Hand"
                            PointerPressed="OnSidebarGroupPressed"
                            DragDrop.AllowDrop="True"
                            ContextRequested="OnSidebarContextRequested"
                            ToolTip.Tip="{Binding Hint}"
                            CornerRadius="4">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Width="3" MinHeight="16" CornerRadius="1.5" Margin="0,0,6,0"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource Accent}"
                                IsVisible="{Binding IsNested}" />
                        <Border Width="3" Margin="0,0,6,0"
                                IsVisible="{Binding !IsNested}" Background="Transparent" />

                        <Border Grid.Column="1" Width="18" MinHeight="18" Margin="0,0,4,0"
                                VerticalAlignment="Top" Background="Transparent" Cursor="Hand"
                                Tag="{Binding}" PointerPressed="OnExpandGlyphPressed">
                          <TextBlock Text="{Binding TreeMark}"
                                     FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextMuted}" />
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="{Binding NameWeight}"
                                   Opacity="{Binding NameOpacity}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"
                                   ToolTip.Tip="{Binding Name}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
                  </Style>
                  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#0A000000" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
            </Border>

            <Border Grid.Column="1" Background="Transparent"
                    ContextRequested="OnContentContextRequested">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="10" ItemsSource="{Binding VisibleItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LaunchItemVm">
                      <Border Classes="tile"
                              Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              Margin="4" CornerRadius="4" Cursor="Hand"
                              PointerPressed="OnTilePressed" Tag="{Binding}"
                              ContextRequested="OnTileContextRequested">
                        <Grid ColumnDefinitions="Auto,*" Margin="6,0">
                          <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextPrimary}" />
                          <TextBlock Text="{Binding Subtitle}" FontSize="10" Opacity="0.55" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>

          <Border IsVisible="{Binding IsMenuOpen}" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,8,12,0" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource BorderLine}"
                  BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="200"
                  BoxShadow="0 4 16 0 #22000000" ZIndex="30">
            <StackPanel>
              <Button Classes="menuItem" Content="添加项目" Command="{Binding OpenAddPanelCommand}" />
              <Button Classes="menuItem" Content="编辑项目" Command="{Binding OpenEditPanelCommand}" />
              <Button Classes="menuItem" Content="添加分类" Command="{Binding AddCategoryCommand}" />
              <Button Classes="menuItem" Content="重命名分类" Command="{Binding OpenRenameGroupCommand}" />
              <Button Classes="menuItem" Content="删除项目" Command="{Binding RemoveSelectedCommand}" />
              <Button Classes="menuItem" Content="删除分类" Command="{Binding RemoveCategoryCommand}" />
              <Separator />
              <Button Classes="menuItem" Content="设置" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>
  </LayoutTransformControl>
</Window>
